		<style type="text/css" id="wp-custom-css">
			button.single_add_to_cart_button, 
a.add_to_cart_button, 
input.add_to_cart_button { 
  display: none !important; 
}

/* ====== Increase logo size for Bridge Store Theme ====== */
.q_logo img { 
  height: 150px !important; 
  max-height: 150px !important; 
  width: auto !important; 
  transition: all 0.3s ease-in-out; 
}

/* For sticky header */
.q_logo a img.sticky { 
  height: 80px !important; 
  max-height: 80px !important; 
}

/* Adjust header height to fit bigger logo */
header.scrolled .q_logo img, 
header .q_logo img { 
  margin-top: -27px !important; 
}
.header_inner_left, 
.q_logo { 
  height: auto !important; 
}

/* Hide quantity selector */
.single-product .cart .quantity { 
  display: none !important; 
}
.qwfw-add-to-wishlist { 
  display: none !important; 
}

/* Header menu text color black */
header a, 
header a:visited, 
header a.current { 
  color: #000 !important; 
}

/* Hover aur active par bhi black */
header a:hover, 
header a:active { 
  color: #90EE90 !important; 
}

/* Header menu font size bigger */
header a, 
header .current { 
  font-size: 18px !important; /* default 14–16 hota hai */
  font-weight: 500; /* thoda bold look ke liye */
  letter-spacing: 0.5px; /* premium spacing */
}

/* Hover par thoda smooth transition */
header a { 
  transition: all 0.3s ease; 
}

/* Center content in top header */
.top-header-left { 
  width: 100%; 
  text-align: center; 
  color: #fff; 
  font-size: 15px; 
}
.top-header-left a { 
  color: #fff; 
  text-decoration: none; 
  margin: 0 10px; 
}
.top-btn { 
  background: #fff; 
  color: #000; 
  padding: 6px 15px; 
  border-radius: 25px; 
  font-weight: 500; 
  text-decoration: none; 
  transition: all 0.3s ease; 
}
.top-btn:hover { 
  background: #00a3ff; 
  color: #fff; 
}
.top-header-left a { 
  color: #fff !important; /* force white */
  text-decoration: none; 
  margin: 0 10px; 
}

div.wpcf7 form input.wpcf7-submit { 
  margin-top: 20px !important; /* Adds space above button */
  background-color: #8BC34A !important; /* Light green */
  color: #ffffff !important; /* White text */
  border: none !important; 
  padding: 7px 27px !important; 
  border-radius: 4px !important; 
  font-size: 16px !important; 
  cursor: pointer !important; 
  transition: background 0.3s ease !important; 
}
div.wpcf7 form input.wpcf7-submit:hover { 
  background-color: #7CB342 !important; /* Darker green on hover */ 
}

/* ===== Bridge Store Footer - Nuclear Reset + Enhancements (mobile) ===== */
@media (max-width: 767px) {
  /* Reset main footer containers */
  footer, 
  .site-footer, 
  #footer, 
  .qode_footer_top_holder, 
  .qode_footer_bottom_holder, 
  .qode_footer_top, 
  .qode_footer_bottom { 
    margin: 0 !important; 
    padding: 0 !important; 
    min-height: 0 !important; 
    height: auto !important; 
  }

  /* Collapse columns and inner wrappers */
  .qode_column, 
  .qode_column_inner, 
  .qode_footer_top .qode_column, 
  .qode_footer_bottom .qode_column { 
    margin: 0 !important; 
    padding: 0 !important; 
    min-height: 0 !important; 
    height: auto !important; 
  }

  /* Force widgets and their children to have minimal spacing */
  footer .widget, 
  .qode_footer_top .widget, 
  .qode_footer_bottom .widget, 
  .widget * { 
    margin: 10 !important; 
    padding: 0 !important; 
    line-height: 2.5 !important; 
    min-height: 0 !important; 
    height: auto !important; 
  }

  /* Hide known spacer/empty elements */
  .vc_empty_space, 
  .elementor-widget-spacer, 
  .spacer, 
  .qode_empty_space, 
  .qode_footer_top .vc_empty_space, 
  .qode_footer_bottom .vc_empty_space { 
    display: none !important; 
    height: 0 !important; 
    min-height: 0 !important; 
    margin: 10 !important; 
    padding: 0 !important; 
  }

  /* Footer text color white */
  footer, 
  footer p, 
  footer a, 
  footer h1, 
  footer h2, 
  footer h3, 
  footer h4, 
  footer h5, 
  footer h6, 
  footer strong, 
  footer label { 
    color: #fff !important; 
  }

  /* Center the form submit button */
  footer input[type="submit"], 
  footer button { 
    display: block !important; 
    margin: 15px auto !important; 
    background: #00b050 !important; /* optional highlight color */
    border: none !important; 
    color: #fff !important; 
  }

  /* Social icons white */
  footer .q_social_icon_holder i, 
  footer .q_social_icon_holder svg path, 
  .widget .social-icons a svg path { 
    color: #fff !important; 
    fill: #fff !important; 
  }

  /* Logo size slightly increased */
  footer img, 
  .qode_footer_bottom_holder img, 
  .qode_footer_top img, 
  .widget img { 
    max-height: 70px !important; 
    width: auto !important; 
    margin: 0 auto !important; 
    display: block !important; 
  }

  /* Space above footer (content to footer gap) */
  .footer_top_holder { 
    margin-top: 25px !important; 
  }

  /* Ensure links stay white */
  footer a:hover { 
    color: #ccc !important; 
  }

  /* Last-resort: directly target deepest descendants to remove stray margins */
  footer * { 
    margin-top: 10 !important; 
    margin-bottom: 10 !important; 
    padding-top: 0 !important; 
    padding-bottom: 0 !important; 
  }
}

/* Remove extra space above footer in Bridge theme */
.footer_top_holder, 
.footer_bottom_holder { 
  margin-top: 10 !important; 
  padding-top: 0 !important; 
}

/* Reduce extra space between footer top and bottom */
.qode_footer_top_holder { 
  margin-bottom: 10 !important; 
  padding-bottom: 0 !important; 
}

/* Reduce spacing inside footer widget rows */
.footer_top, 
.footer_bottom { 
  padding-top: 10px !important; 
  padding-bottom: 10px !important; 
}

.single-onsale.onsale-outter { 
  display: none !important; 
  visibility: hidden !important; 
  opacity: 0 !important; 
}

/* 🔹 Mobile header adjustments */
@media (max-width: 767px) {
  /* Menu icon (hamburger) size & color */
  .qode-mobile-menu-opener, 
  .qodef-mobile-header-opener, 
  .elementor-menu-toggle i, 
  .mobile_menu_button i { 
    font-size: 28px !important; /* icon size */
    color: #000 !important; /* black color */
  }

  /* Center the logo */
  .qodef-mobile-header-logo, 
  .q_logo img, 
  .custom-logo, 
  .elementor-widget-theme-site-logo { 
    display: block !important; 
    margin: 0 auto !important; 
    text-align: center !important; 
  }

  /* Align menu button and logo vertically */
  .qodef-mobile-header-inner, 
  .qode-mobile-header-inner, 
  .elementor-widget-theme-site-logo { 
    display: flex !important; 
    align-items: center !important; 
    justify-content: center !important; 
  }
}

@media (max-width: 767px) {
  /* ✅ Apply spacing on all pages EXCEPT page ID 195 and 200 */
  body:not(.page-id-195):not(.page-id-200) .elementor-section, 
  body:not(.page-id-195):not(.page-id-200) .elementor-container, 
  body:not(.page-id-195):not(.page-id-200) .elementor-widget-text-editor { 
    padding-left: 15px !important; 
    padding-right: 15px !important; 
  }

  /* ✅ Text spacing (also excluded on page 195 and 200) */
  body:not(.page-id-195):not(.page-id-200) p, 
  body:not(.page-id-195):not(.page-id-200) h1 { 
    line-height: 1.5 !important; 
    letter-spacing: 0.3px !important; 
  }

  /* ✅ Footer top spacing (gap between content and footer) */
  footer, 
  .site-footer { 
    margin-top: 25px !important; 
  }
}

@@media (max-width: 767px) { 
  /* Apply spacing on all pages EXCEPT page ID 195 */
  body:not(.page-id-195) .elementor-section, 
  body:not(.page-id-195) .elementor-container, 
  body:not(.page-id-195) .elementor-widget-text-editor { 
    padding-left: 15px !important; 
    padding-right: 15px !important; 
  }

  /* Optional: text spacing (also excluded on page 195) */
  body:not(.page-id-195) p, 
  body:not(.page-id-195) h1, 
  @media (max-width: 767px) { 
    /* Footer top spacing (gap between video/content and footer) */
    footer, 
    .site-footer { 
      margin-top: 25px !important; 
    } 
  }
}

media (max-width: 767px) { 
  /* ✅ Apply spacing on all pages EXCEPT page ID 195 and 200 */
  body:not(.page-id-195):not(.page-id-200) .elementor-section, 
  body:not(.page-id-195):not(.page-id-200) .elementor-container, 
  body:not(.page-id-195):not(.page-id-200) .elementor-widget-text-editor { 
    padding-left: 15px !important; 
    padding-right: 15px !important; 
  }

  /* ✅ Text spacing (also excluded on page 195 and 200) */
  body:not(.page-id-195):not(.page-id-200) p, 
  body:not(.page-id-195):not(.page-id-200) h1 { 
    line-height: 1.5 !important; 
    letter-spacing: 0.3px !important; 
  }

  /* ✅ Footer top spacing (gap between content and footer) */
  footer, 
  .site-footer { 
    margin-top: 25px !important; 
  }
}

/* Style all CF7 text inputs, email, tel, and textarea fields */
.wpcf7 input[type="text"], 
.wpcf7 input[type="email"], 
.wpcf7 input[type="tel"], 
.wpcf7 textarea { 
  font-family: 'Poppins', sans-serif; 
  font-size: 16px; 
  color: #000; /* Text color */
  background-color: #fff; 
  border: 1px solid #ccc; 
  border-radius: 0px; 
  padding: 12px 15px; 
  width: 100%; 
  box-sizing: border-box; 
  transition: 0.3s; 
}

/* Focus effect */
.wpcf7 input:focus, 
.wpcf7 textarea:focus { 
  border-color: #0073e6; 
  box-shadow: 0 0 5px rgba(0,115,230,0.3); 
  outline: none; 
}

/* Placeholder color */
.wpcf7 ::placeholder { 
  color: #888; 
  font-style: italic; 
}

/* Submit button styling */
.wpcf7 input[type="submit"] { 
  background: #000; 
  color: #fff; 
  border: none; 
  border-radius: 8px; 
  padding: 12px 25px; 
  font-size: 16px; 
  cursor: pointer; 
  transition: background 0.3s; 
}
.wpcf7 input[type="submit"]:hover { 
  background: #ff6600; 
}

/* ===== FORCE FULL WIDTH (targets page ID 195) ===== */
body.page-id-195, 
body.page-id-195 .site, 
body.page-id-195 .site-content, 
body.page-id-195 .wrap, 
body.page-id-195 .container, 
body.page-id-195 .content-area { 
  max-width: 100% !important; 
  width: 100% !important; 
  padding-left: 0 !important; 
  padding-right: 0 !important; 
  margin-left: 0 !important; 
  margin-right: 0 !important; 
  box-sizing: border-box !important; 
}

/* Make Elementor sections / containers full-bleed */
body.page-id-195 .elementor-section, 
body.page-id-195 .elementor-section .elementor-container, 
body.page-id-195 .elementor-column, 
body.page-id-195 .elementor-widget { 
  max-width: 100% !important; 
  width: 100% !important; 
  padding: 0 !important; 
  margin: 0 !important; 
}

/* small breathing room — change to 0 if you want zero gap */
  padding-right: 12px !important; 
}

/* Images, iframes and hero banners */
body.page-id-195 img, 
body.page-id-195 .elementor-image img, 
body.page-id-195 iframe { 
  display: block !important; 
  width: 100% !important; 
  height: auto !important; 
  max-width: 100% !important; 
}

/* Mobile tweaks — reduce any left/right gap on phones */
@media (max-width: 767px) { 
  body.page-id-195, 
  body.page-id-195 .elementor-section, 
  body.page-id-195 .elementor-container { 
    padding-left: 6px !important; 
    padding-right: 6px !important; 
  }

  body.page-id-195 .elementor-section.elementor-section-boxed > .elementor-container { 
    padding-left: 6px !important; 
    padding-right: 6px !important; 
  } 
}
/* ===== FIX ONLY PRODUCT GRID (Bridge Product List) ON PRODUCTS PAGE ===== */
.qode-pl-holder {
  display: flex !important;
  flex-wrap: wrap !important;
  justify-content: center !important;
  align-items: flex-start !important;
  gap: 25px !important;
}

.qode-pl-holder .qode-pli {
  flex: 0 0 calc(33.333% - 25px) !important; /* 3 per row desktop */
  box-sizing: border-box !important;
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: flex-start !important;
  text-align: center !important;
}

.qode-pl-holder .qode-pli img {
  width: 100% !important;
  height: 300px !important;
  object-fit: cover !important;
  display: block !important;
}

/* Tablet view (2 per row) */
@media (max-width: 1024px) {
  .qode-pl-holder .qode-pli {
    flex: 0 0 calc(50% - 20px) !important;
  }
}

/* Mobile view (1 per row, with side spacing) */
@media (max-width: 767px) {
  .qode-pl-holder .qode-pli {
    flex: 0 0 100% !important;
  }

  .qode-pl-holder {
    padding: 0 15px !important;
  }
}
/* Force change for Know More button */
body a.add-request-quote-button.button,
.woocommerce a.add-request-quote-button.button,
.single-product a.add-request-quote-button.button {
  background-color: #70ED70 !important;
  border-color: #70ED70 !important;
  color: #000 !important;
  font-weight: 600 !important;
  border-radius: 6px !important;
  padding: 10px 25px !important;
  transition: all 0.3s ease !important;
}

/* Hover effect */
body a.add-request-quote-button.button:hover,
.single-product a.add-request-quote-button.button:hover {
  background-color: #57d857 !important;
  color: #fff !important;
}
/* Remove SALE badge from all products */
span.onsale,
span.onsale-onsale,
span.onsale-outter,
.onsale {
  display: none !important;
}
/* Mobile logo position adjustment */
@media (max-width: 767px) {
  .q_logo {
    position: relative !important;
    top: -15px; /* move UP — increase to move higher */
    /* use positive value like 8px to move DOWN */
  }

  .q_logo img {
    max-height: 150px !important; /* adjust logo size if needed */
    height: auto !important;
  }
}
